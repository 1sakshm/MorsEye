# Cloudflare Pages response headers (the equivalent of vercel.json).

# Study Mode and the labelling tool are not for search engines (PRD §6.2).
/study/*
  X-Robots-Tag: noindex, nofollow
/labeler/*
  X-Robots-Tag: noindex, nofollow

# Vite's hashed bundles never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The model and WASM keep their names across versions, so cache them for a day only.
/models/*
  Cache-Control: public, max-age=86400
/wasm/*
  Cache-Control: public, max-age=86400
