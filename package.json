{
  "name": "morseye",
  "version": "2.0.0",
  "private": true,
  "description": "Telling deliberate from spontaneous blinks on a webcam: few-shot calibration for blink-based Morse text entry.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "replay": "vite-node scripts/replay.ts",
    "predev": "node scripts/fetch-model.mjs",
    "prebuild": "node scripts/fetch-model.mjs",
    "paper": "cd paper && latexmk && cd .. && node -e \"require('fs').copyFileSync('paper/main.pdf','public/paper/morseye-draft.pdf')\""
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@mediapipe/tasks-vision": "0.10.21",
    "d3": "7.9.0",
    "gsap": "3.13.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/d3": "7.4.3",
    "@types/node": "22.15.30",
    "eslint": "9.39.5",
    "globals": "16.2.0",
    "jsdom": "26.1.0",
    "prettier": "3.5.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "7.3.7",
    "vite-node": "3.2.4",
    "vitest": "3.2.4"
  }
}
